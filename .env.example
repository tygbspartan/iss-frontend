# Base URL of the iss-be backend, without a trailing slash.
# Must be NEXT_PUBLIC_ because the browser calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public URL of the website (no trailing slash). Used for absolute URLs in
# link previews and Google structured data. Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Note: the Instagram feed on the home page needs nothing here. Its access
# token lives in the backend (INSTAGRAM_ACCESS_TOKEN in iss-be/.env), which
# renews it automatically.

# Demo mode: "true" answers every backend request with made-up content from
# src/lib/mock (and keeps search engines out). Only for a frontend-only
# preview, never for the real site.
NEXT_PUBLIC_USE_MOCK_DATA=false
